{
  "manifest": "workflow/v1",
  "branch": {
    "integration": "dev",
    "publish": "main"
  },
  "commitTrailer": "Claude-Session",
  "record": {
    "todo": "TODO.md",
    "roadmap": "ROADMAP.md",
    "changelog": "CHANGELOG.md",
    "handoff": ".claude/HANDOFF.md",
    "decisions": "docs/decisions.md",
    "decisionsIndex": "docs/decisions-index.md",
    "openDecisions": "docs/open-decisions.md",
    "audits": "docs/audits.md",
    "reference": [
      "README.md"
    ],
    "tooling": {
      "catalog": ".claude/TOOLING.md",
      "sources": [
        "skills/*/SKILL.md",
        "skills/*/references/*.md",
        "workflow/writers/*.md",
        "workflow/checks/*.md",
        "commands/*.md"
      ]
    }
  },
  "commands": {
    "typecheck": "while read -r f; do bash -n \"$f\" || exit 1; done < <(git ls-files '*.sh')",
    "test": "bash tests/hook-contract.sh",
    "indexRegen": "bash skills/ws-record/assets/index-decisions.sh",
    "indexCheck": "bash skills/ws-record/assets/index-decisions.sh --check",
    "ci": {
      "tool": "gh",
      "workflow": "Verify"
    }
  },
  "sweeps": ".claude/sweeps.json"
}
